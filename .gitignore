# Dependencies
node_modules/
functions/node_modules/

# Build and local runtime files
dist/
build/
.firebase/
.runtimeconfig.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Environment and sensitive credential files
public/js/firebaseConfig.js
.env
.env.local
.env.*.local
*.env
serviceAccount*.json
service-account*.json
*credential*.json

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE and Editor files
.idea/
.vscode/
*.suo
*.ntvsopt
*.njsproj
*.sln
*.sw?

# Temporary & Archive files
*.zip
*.tar.gz
*.rar

# Agent & Brain files
.gemini/
.agents/
scratch/

# Testing & Coverage
coverage/
.nyc_output/
.claude-memory/
.memoryfires/

# Local working notes, not tracked.
CLAUDE.md
COUNCIL.md

# Backups left behind by earlier cleanups. Kept on disk deliberately; not
# history.
_to_delete_*.bak

# Personal to-do list (account details); not project history.
YAPILACAKLAR.md

# Key files. A service-account key downloaded from the Firebase console is named
# <project>-firebase-adminsdk-<id>.json -- none of the patterns above matched it.
*firebase-adminsdk*.json
*.pem
*.p12
*.pfx
*.key

# commit.bat's message for the release being recorded: input, not history.
.commit-msg.txt

# Local git bundles and one-off maintenance scripts.
*.bundle
finish-history.bat
