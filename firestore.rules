// firestore.rules — deployable form of FIRESTORE_RULES.md.
//
// ⚠️ REVIEW BEFORE YOUR FIRST DEPLOY OF THIS FILE.
//    Until v3.0.0 the project had no firestore.rules; the live rules were
//    edited by hand in the Firebase console, and this file is reconstructed
//    from FIRESTORE_RULES.md. If anything was changed in the console and never
//    written back to that document, deploying this WILL overwrite it.
//    Open the console (Firestore Database → Rules), compare, and merge any
//    difference into this file first. Once they match, this file becomes the
//    source of truth and the console stops being a place changes get lost.
//
//    `deploy.bat` / `deploy.sh` deploy HOSTING ONLY for exactly this reason.
//    Rules go out separately, on purpose:
//        firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers (security review, v3.18.0) ─────────────────────────
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // A display name other players will see. MIRRORED in public/js/safeText.js
    // (NAME_PATTERN); test section 81 fails the build if the two differ.
    function validName(n) {
      return n is string && n.matches('^[\\p{L}\\p{N} _.\\-]{1,24}$');
    }

    // ── 1. Users: PRIVATE. ─────────────────────────────────────────────────
    //    Until v3.18.0 this collection was world-readable AND held each
    //    player's email: anyone could list every account's address without
    //    signing in. The email lives in Firebase Authentication; the client
    //    no longer writes it here and deletes an old copy at sign-in.
    //    The leaderboard reads /leaderboard instead (block 2).
    //
    //    A record moves one finished match at a time (playerRecord.js):
    //    each counter +0 or +1, score only with a win, a win only with a game,
    //    at most once every 10 s. This bounds a forged record; it does not
    //    prove a match happened — only a server-refereed match can.
    function counterStep(f) {
      return request.resource.data.get(f, 0) is int
             && (request.resource.data.get(f, 0) == resource.data.get(f, 0)
                 || request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1);
    }
    function grew(f) { return request.resource.data.get(f, 0) != resource.data.get(f, 0); }
    function validReflex(r) { return r is int && r >= 80 && r <= 60000; }

    match /users/{userId} {
      allow read: if isUser(userId);

      allow create: if isUser(userId)
        && request.resource.data.keys().hasOnly(['username', 'totalScore', 'gamesPlayed', 'gamesWon', 'bestReflex', 'updatedAt'])
        && validName(request.resource.data.username)
        && request.resource.data.get('totalScore', 0) == 0
        && request.resource.data.get('gamesPlayed', 0) == 0
        && request.resource.data.get('gamesWon', 0) == 0
        && request.resource.data.get('bestReflex', null) == null
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);

      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username', 'totalScore', 'gamesPlayed', 'gamesWon', 'bestReflex', 'updatedAt', 'email'])
        // `email` may only change by being REMOVED.
        && !('email' in request.resource.data.diff(resource.data).affectedKeys() && 'email' in request.resource.data)
        && (!('username' in request.resource.data.diff(resource.data).affectedKeys()) || validName(request.resource.data.username))
        && counterStep('totalScore') && counterStep('gamesPlayed') && counterStep('gamesWon')
        && request.resource.data.get('totalScore', 0) - resource.data.get('totalScore', 0)
             == request.resource.data.get('gamesWon', 0) - resource.data.get('gamesWon', 0)
        && request.resource.data.get('gamesWon', 0) - resource.data.get('gamesWon', 0)
             <= request.resource.data.get('gamesPlayed', 0) - resource.data.get('gamesPlayed', 0)
        && (!('bestReflex' in request.resource.data.diff(resource.data).affectedKeys())
            || (validReflex(request.resource.data.bestReflex)
                && (!validReflex(resource.data.get('bestReflex', null))
                    || request.resource.data.bestReflex < resource.data.bestReflex)))
        && (!('updatedAt' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.updatedAt == request.time)
        // A counter moves only with a fresh stamp, and not within 10 s of the last.
        && (!(grew('totalScore') || grew('gamesPlayed') || grew('gamesWon'))
            || (request.resource.data.get('updatedAt', null) == request.time
                && (resource.data.get('updatedAt', null) == null
                    || request.time > resource.data.updatedAt + duration.value(10, 's'))));

      allow delete: if false;
    }

    // ── 2. Leaderboard: public, and only a mirror. ─────────────────────────
    //    A name and a score. The score must equal the private record's score
    //    after this commit (getAfter), so it can only follow a record that
    //    block 1 let move.
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if isUser(userId)
        && request.resource.data.keys().hasOnly(['username', 'totalScore', 'updatedAt'])
        && validName(request.resource.data.username)
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore
             == getAfter(/databases/$(database)/documents/users/$(userId)).data.get('totalScore', 0)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isUser(userId);
    }

    // ── 3. Multiplayer tables. ─────────────────────────────────────────────
    //    Until v3.18.0 ANY signed-in user could rewrite ANY table. Now:
    //    the host and seated players may update it; a stranger may only JOIN
    //    a waiting table by adding exactly themselves. `playerIds` is the map
    //    of seated people (tableIds.js) — rules cannot look inside `players`.
    //    Only the host may start a game or change its rules and god.
    function ids(d) { return d.get('playerIds', {}); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /multiplayer_tables/{tableId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in ids(request.resource.data)
        && request.resource.data.tableId == tableId;

      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.tableId == resource.data.tableId
        // A new host must be a seated person (a bot conversion may leave the
        // old one listed as host; that is not a reason to refuse the write).
        && (!('hostId' in changed()) || request.resource.data.hostId in ids(request.resource.data))
        && (
             resource.data.hostId == request.auth.uid
             || (
                  (request.auth.uid in ids(resource.data)
                   || (resource.data.gameState.status == 'waiting'
                       && request.auth.uid in ids(request.resource.data)
                       && ids(request.resource.data).keys().removeAll(ids(resource.data).keys()).hasOnly([request.auth.uid])
                       && ids(resource.data).keys().removeAll(ids(request.resource.data).keys()).size() == 0))
                  && changed().hasOnly(['players', 'playerIds', 'gameState', 'hostId', 'hostUsername'])
                  && request.resource.data.gameState.status == resource.data.gameState.status
                  && request.resource.data.gameState.get('roomId', null) == resource.data.gameState.get('roomId', null)
                )
           );
    }

    // ── 4. Daily Challenge boards (v3.0.0, hardened v3.1.1).
    //
    //    ⚠️ READ THIS BEFORE TRUSTING THE BOARD. The score is computed in the
    //    browser and written here directly. NOTHING below verifies that a
    //    submitted score corresponds to a match that was actually played. A
    //    client that sends a well-formed lie — won:true with a plausible reflex
    //    and duration — passes every rule in this block. That is why the panel
    //    carries an "unverified board" notice and why
    //    DailyChallenge.VERIFIED_BOARD is false. Turning these rules into a
    //    real boundary needs a Cloud Function that recomputes the score from a
    //    server-held match log; until then, do not describe this board as
    //    verified anywhere in the UI or the docs.
    //
    //    WHAT THIS BLOCK DOES BUY, precisely:
    //      · the one-line console attack (setDoc(ref, {score: 5000})) now fails
    //        on shape — every field is required, typed and bounded;
    //      · scores can never be downgraded or deleted, only improved;
    //      · a write cannot be backdated or replayed (`at` must sit within five
    //        minutes of server time);
    //      · no attacker-chosen extra fields can be smuggled into the document
    //        (hasOnly), so the board renderer only ever sees known keys.
    //
    //    MIRRORED IN public/js/dailyScore.js (SCORE_BOUNDS / SCORE_FIELDS).
    //    `npm run check:score-bounds` fails the build if the two drift apart.
    //    If you change a bound here, change it there in the same commit.
    match /daily_challenges/{dateKey}/scores/{userId} {
      allow read: if true;

      function validScore(d) {
        return d.keys().hasOnly(['uid', 'username', 'score', 'reflex', 'won',
                                 'durationMs', 'profile', 'startingCards', 'at'])
               && d.keys().hasAll(['uid', 'username', 'score', 'reflex', 'won',
                                   'durationMs', 'profile', 'startingCards', 'at'])
               && d.uid == userId
               && d.username is string && d.username.size() > 0 && d.username.size() <= 24
               && d.won is bool
               && d.score is int && d.score >= 0 && d.score <= 5000
               && d.reflex is int && d.reflex >= 80 && d.reflex <= 60000
               && d.durationMs is int && d.durationMs >= 0 && d.durationMs <= 3600000
               && d.startingCards is int && d.startingCards >= 1 && d.startingCards <= 52
               && (d.profile == null || d.profile in ['comeback', 'knifeEdge', 'finisher'])
               && d.at is int
               // Not backdated, not replayed from an old capture.
               && d.at <= request.time.toMillis() + 300000
               && d.at >= request.time.toMillis() - 300000;
      }

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && validScore(request.resource.data);

      // Improvements only. A later run may raise your entry; nothing may lower
      // it, and nothing may rewrite the identity on it.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && validScore(request.resource.data)
                    && request.resource.data.score > resource.data.score;

      allow delete: if false;
    }

    // ── 6. Coins: the server owns the ledger (v3.22.0). ─────────────────────
    //    Until v3.22.0 the balance and the owned skins lived in localStorage;
    //    one console line minted any amount. Now `wallets/{uid}` is the only
    //    balance, and a player may move it in exactly five shapes (walletRules.js
    //    mirrors each one; the test suite fails the build if the numbers drift):
    //      create    once: an import of the old local balance, worth ≤ 1000
    //      spend     down only (a loss, a quit)
    //      purchase  one catalogue skin in, exactly its price out
    //      earn      ≤ 80 a write, ≤ 1200 a UTC day
    //      spin      ≤ 200, once a UTC day by the server's clock
    //    Any other amount is an admin grant, and only an account with a
    //    document in /admins may make one. /admins has no client write rule at
    //    all: an admin is made by hand in the Firebase console, nowhere else.
    //    Each grant commits with an immutable /coin_grants audit record.
    //
    //    What this does NOT do: the browser still decides who won a match, so
    //    a forger can claim wins — up to the daily cap a real player meets.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function walletSkinCost() {
      return {'golden': 150, 'neon': 150, 'shadow': 200, 'inferno': 200, 'frost': 200,
              'emerald': 250, 'royal': 250, 'sakura': 300, 'phantom': 350,
              'holographic': 400, 'obsidian': 500, 'pharaoh': 1000, 'gods': 2000};
    }
    function today() { return math.floor(request.time.toMillis() / 86400000); }
    function walletShape(d) {
      return d.keys().hasOnly(['coins', 'owned', 'earnDay', 'earnedToday', 'spinDay', 'lastGrantId', 'updatedAt'])
             && d.keys().hasAll(['coins', 'owned', 'earnDay', 'earnedToday', 'spinDay', 'updatedAt'])
             && d.coins is int && d.coins >= 0
             && d.owned is list && d.owned.size() <= 20 && 'classic' in d.owned
             && d.earnDay is int && d.earnedToday is int && d.spinDay is int
             && d.updatedAt == request.time;
    }
    // The imported value: coins plus every owned skin at its price.
    function ownedValue(o) {
      return ('golden' in o ? 150 : 0) + ('neon' in o ? 150 : 0) + ('shadow' in o ? 200 : 0)
           + ('inferno' in o ? 200 : 0) + ('frost' in o ? 200 : 0) + ('emerald' in o ? 250 : 0)
           + ('royal' in o ? 250 : 0) + ('sakura' in o ? 300 : 0) + ('phantom' in o ? 350 : 0)
           + ('holographic' in o ? 400 : 0) + ('obsidian' in o ? 500 : 0) + ('pharaoh' in o ? 1000 : 0)
           + ('gods' in o ? 2000 : 0);
    }
    function walletChanged() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function coinDelta() { return request.resource.data.coins - resource.data.coins; }

    function isSpend() {
      return walletChanged().hasOnly(['coins', 'updatedAt']) && coinDelta() < 0;
    }
    function isPurchase() {
      let n = request.resource.data;
      let o = resource.data;
      let added = n.owned.removeAll(o.owned);
      return walletChanged().hasOnly(['coins', 'owned', 'updatedAt'])
             && n.owned.hasAll(o.owned)
             && n.owned.size() == o.owned.size() + 1
             && added.size() == 1
             && added[0] in walletSkinCost()
             && coinDelta() == -walletSkinCost()[added[0]];
    }
    function isEarn() {
      let n = request.resource.data;
      let o = resource.data;
      return walletChanged().hasOnly(['coins', 'earnDay', 'earnedToday', 'updatedAt'])
             && coinDelta() > 0 && coinDelta() <= 80
             && n.earnDay == today()
             && n.earnedToday == (o.earnDay == today() ? o.earnedToday : 0) + coinDelta()
             && n.earnedToday <= 1200;
    }
    function isSpin() {
      return walletChanged().hasOnly(['coins', 'spinDay', 'updatedAt'])
             && coinDelta() >= 0 && coinDelta() <= 200
             && resource.data.spinDay < today()
             && request.resource.data.spinDay == today();
    }
    // An admin grant: only the balance moves, and the audit record written in
    // the same commit names this wallet and this exact amount.
    function isAdminGrant(userId) {
      let grant = getAfter(/databases/$(database)/documents/coin_grants/$(request.resource.data.lastGrantId)).data;
      return isAdmin()
             && walletChanged().hasOnly(['coins', 'lastGrantId', 'updatedAt'])
             && request.resource.data.lastGrantId is string
             && request.resource.data.lastGrantId != resource.data.get('lastGrantId', '')
             // written in THIS commit — an old record cannot be replayed
             && !exists(/databases/$(database)/documents/coin_grants/$(request.resource.data.lastGrantId))
             && grant.to == userId
             && grant.by == request.auth.uid
             && grant.amount == coinDelta();
    }

    match /wallets/{userId} {
      allow read: if isUser(userId) || isAdmin();

      allow create: if isUser(userId)
        && walletShape(request.resource.data)
        && request.resource.data.owned.hasOnly(walletSkinCost().keys().concat(['classic']))
        && request.resource.data.coins + ownedValue(request.resource.data.owned) <= 1000
        && request.resource.data.earnDay == -1
        && request.resource.data.earnedToday == 0
        && request.resource.data.spinDay == -1
        && request.resource.data.get('lastGrantId', '') == '';

      allow update: if walletShape(request.resource.data)
        && ((isUser(userId) && (isSpend() || isPurchase() || isEarn() || isSpin()))
            || isAdminGrant(userId));

      allow delete: if false;
    }

    // Admin accounts. Readable by their owner (so the game knows to show the
    // panel); NO client write rule — created by hand in the Firebase console.
    match /admins/{userId} {
      allow read: if isUser(userId);
      allow write: if false;
    }

    // The audit trail: created only by an admin, together with the wallet
    // change it describes; never edited, never deleted.
    match /coin_grants/{grantId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'by', 'amount', 'before', 'after', 'note', 'at'])
        && request.resource.data.keys().hasAll(['to', 'by', 'amount', 'before', 'after', 'note', 'at'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.amount is int
        && request.resource.data.amount != 0
        && request.resource.data.amount >= -100000 && request.resource.data.amount <= 100000
        && request.resource.data.note is string && request.resource.data.note.size() <= 120
        && request.resource.data.at == request.time
        && request.resource.data.before == get(/databases/$(database)/documents/wallets/$(request.resource.data.to)).data.coins
        && request.resource.data.after == request.resource.data.before + request.resource.data.amount
        && request.resource.data.after >= 0
        && getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.to)).data.coins == request.resource.data.after
        && getAfter(/databases/$(database)/documents/wallets/$(request.resource.data.to)).data.lastGrantId == grantId
        // ...and the sending admin's daily counter moved with it (below).
        && getAfter(/databases/$(database)/documents/admin_daily/$(request.auth.uid)).data.lastGrantId == grantId;
      allow update, delete: if false;
    }

    // The admin's daily ceiling (v3.22.1, council finding O1). A stolen admin
    // password must not mean unlimited coins: an admin may GIVE at most 20000
    // a UTC day (taking back is not counted). The counter moves only together
    // with a grant written in the same commit, so it cannot be reset alone.
    // MIRRORED in walletRules.js (ADMIN_DAILY_CAP).
    function adminGrantAfter(id) {
      return getAfter(/databases/$(database)/documents/coin_grants/$(id)).data;
    }
    match /admin_daily/{userId} {
      allow read: if isUser(userId) && isAdmin();
      allow create, update: if isUser(userId) && isAdmin()
        && request.resource.data.keys().hasOnly(['day', 'given', 'lastGrantId'])
        && request.resource.data.lastGrantId is string
        && request.resource.data.lastGrantId != (resource == null ? '' : resource.data.get('lastGrantId', ''))
        && !exists(/databases/$(database)/documents/coin_grants/$(request.resource.data.lastGrantId))
        && adminGrantAfter(request.resource.data.lastGrantId).by == userId
        && request.resource.data.day == today()
        && request.resource.data.given
             == ((resource != null && resource.data.day == today()) ? resource.data.given : 0)
                + (adminGrantAfter(request.resource.data.lastGrantId).amount > 0
                   ? adminGrantAfter(request.resource.data.lastGrantId).amount : 0)
        && request.resource.data.given <= 20000;
      allow delete: if false;
    }

    // ── 5. Firestore game rooms: CLOSED. ─────────────────────────────────────
    //    Live matches run on the Realtime Database (database.rules.json).
    //    Nothing in the client reads or writes these paths; an open rule on an
    //    unused path is attack surface with no user.
    match /gameRooms/{roomId}/{document=**} {
      allow read, write: if false;
    }
  }
}
